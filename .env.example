# Required
TELEGRAM_BOT_TOKEN=
TELEGRAPH_ACCESS_TOKEN=
ALLOWED_USER_IDS=          # comma-separated; empty = open to anyone (NOT recommended)

# Provider keys — fill in any you have. The active one is whichever you
# select via /config in Telegram; the rest sit unused but won't hurt.
# At least one is required so that /config has something to work with.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=         # qwen
DASHSCOPE_CN_API_KEY=      # qwen China endpoint (only one of the two is needed)
ZHIPU_API_KEY=             # glm (renamed upstream in tradingagents v0.2.5 from ZHIPUAI_API_KEY)
ZHIPU_CN_API_KEY=          # glm China endpoint (only one of the two is needed)
MINIMAX_API_KEY=           # minimax (added in tradingagents v0.2.5)
MINIMAX_CN_API_KEY=        # minimax China endpoint (only one of the two is needed)
OPENROUTER_API_KEY=        # openrouter — routes to upstream models (free Llama 3.3 etc.)
# Ollama runs locally — no key needed. Point at a remote instance if needed:
# OLLAMA_BASE_URL=http://your-ollama-host:11434/v1

# Persist /history + yfinance cache via the bind-mounted ./data volume.
# Without these, /history is wiped on every restart inside the container.
TRADINGAGENTS_RESULTS_DIR=/app/data/ta-logs
TRADINGAGENTS_CACHE_DIR=/app/data/ta-cache

# Optional bot tuning
# TG_BOT_MAX_CONCURRENT_ANALYSES=3   # bot-wide concurrency cap
# TG_BOT_TA_DEBUG=                   # 1/true to enable verbose graph debug
# TG_BOT_DATA_DIR=data

# Optional tradingagents DEFAULT_CONFIG overlay. Each TRADINGAGENTS_* below,
# when set, replaces the matching key in tradingagents/default_config.py.
# Values are coerced to the existing default's type ("true"/"3" both work).
# The bot's /config UI handles most knobs already — these are for power
# users who want a process-wide override (e.g. force a debate-round
# default for digest fan-outs across all users).
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1    # bull/bear debate rounds per analysis
# TRADINGAGENTS_MAX_RISK_ROUNDS=1      # risk-management discussion rounds (added in v0.2.5)
# TRADINGAGENTS_OUTPUT_LANGUAGE=English # language for analyst reports + final decision
# TRADINGAGENTS_CHECKPOINT_ENABLED=false # LangGraph state checkpointing — resume after crash
# TRADINGAGENTS_BENCHMARK_TICKER=       # override alpha benchmark (default: SPY for US, regional for non-US)
# TRADINGAGENTS_LLM_PROVIDER=openai     # /config typically sets this — overlay forces it bot-wide
# TRADINGAGENTS_DEEP_THINK_LLM=         # same — /config is usually preferred
# TRADINGAGENTS_QUICK_THINK_LLM=        # same — /config is usually preferred
