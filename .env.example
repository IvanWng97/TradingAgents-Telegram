# ════════════════════════════════════════════════════════════════════════
# Telegram bot config (owned by tg_bot)
# ════════════════════════════════════════════════════════════════════════

# Required
TELEGRAM_BOT_TOKEN=
TELEGRAPH_ACCESS_TOKEN=
ALLOWED_USER_IDS=          # comma-separated; empty = open to anyone (NOT recommended)

# Optional tuning
# TG_BOT_MAX_CONCURRENT_ANALYSES=3   # bot-wide concurrency cap
# TG_BOT_TA_DEBUG=                   # 1/true to enable verbose graph debug
# TG_BOT_DATA_DIR=data               # storage for watchlist.json + user_config.json


# ════════════════════════════════════════════════════════════════════════
# TradingAgents config (consumed by the upstream tradingagents library)
# .env is the single source of truth — no in-bot /config UI.
# Restart the bot to pick up changes.
# ════════════════════════════════════════════════════════════════════════

# Active LLM provider + model pair. Only the keys for your chosen provider
# need to be filled; siblings can stay blank.
TRADINGAGENTS_LLM_PROVIDER=deepseek
TRADINGAGENTS_DEEP_THINK_LLM=deepseek-v4-pro
TRADINGAGENTS_QUICK_THINK_LLM=deepseek-v4-flash

# Provider API keys — fill in whichever matches TRADINGAGENTS_LLM_PROVIDER above.
# CN variants (qwen-cn / glm-cn / minimax-cn) use DISTINCT env vars — they
# don't share with their non-CN siblings.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
XAI_API_KEY=
DASHSCOPE_API_KEY=         # qwen
DASHSCOPE_CN_API_KEY=      # qwen-cn (distinct from DASHSCOPE_API_KEY)
ZHIPU_API_KEY=             # glm (renamed upstream in v0.2.5 from ZHIPUAI_API_KEY)
ZHIPU_CN_API_KEY=          # glm-cn (distinct from ZHIPU_API_KEY)
MINIMAX_API_KEY=           # minimax (added in v0.2.5)
MINIMAX_CN_API_KEY=        # minimax-cn (distinct from MINIMAX_API_KEY)
OPENROUTER_API_KEY=        # openrouter — routes to upstream models (free Llama 3.3 etc.)
# Ollama runs locally — no key needed.

# Optional LLM tuning
# TRADINGAGENTS_MAX_DEBATE_ROUNDS=1            # 1/2/3; higher = more nuanced thesis (~1.5-2x cost)
# TRADINGAGENTS_OPENAI_REASONING_EFFORT=       # low/medium/high (openai only)
# TRADINGAGENTS_ANTHROPIC_EFFORT=              # low/medium/high (anthropic only)
# TRADINGAGENTS_GOOGLE_THINKING_LEVEL=         # low/medium/high (google only)

# Persistence — point at /app/data subpaths so /history + yfinance cache
# survive container restarts via the bind-mounted ./data volume.
TRADINGAGENTS_RESULTS_DIR=/app/data/ta-logs
TRADINGAGENTS_CACHE_DIR=/app/data/ta-cache
